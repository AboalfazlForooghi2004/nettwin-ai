# NetTwin AI — LLM gateway configuration template (OpenAI-compatible API)
# Copy to `.env` and fill in your key:   cp env.example .env
# `.env` is gitignored — your key never goes to GitHub.
LLM_BASE_URL=https://llm-net.partcorp.ir/v1
LLM_API_KEY=REPLACE_WITH_YOUR_KEY
LLM_MODELS=qwen-36-35b-reasoning,qwen-38-27b-reasoning,qwen-38-27b-instruct,qwen-36-35b-instruct
LLM_DEFAULT_MODEL=qwen-38-27b-instruct
